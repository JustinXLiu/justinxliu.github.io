---
import Layout from './Layout.astro';

const { title, date, description } = Astro.props.frontmatter;
---

<Layout title={title}>
  <div class="max-w-2xl mx-auto">
    <div class="mb-8">
      <p class="text-xs text-gray-400 dark:text-gray-600 tabular-nums">{date}</p>
      <h1 class="text-2xl font-bold tracking-tight mt-2">{title}</h1>
      {description && <p class="text-gray-500 dark:text-gray-400 mt-2 text-sm">{description}</p>}
    </div>
    <article class="article">
      <slot />
    </article>
    <div class="mt-10 pt-6 border-t border-gray-200 dark:border-white/10 text-sm">
      <a href="/blog/" class="text-emerald-600 dark:text-emerald-400 hover:underline">&larr; all posts</a>
    </div>
  </div>
</Layout>
