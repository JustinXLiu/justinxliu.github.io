---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const links = [
  { href: '/portfolio/', label: 'portfolio', match: (p: string) => p.startsWith('/portfolio') },
  { href: '/blog/', label: 'blog', match: (p: string) => p.startsWith('/blog') },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Justin Liu - Personal Portfolio Dashboard" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title} | justin liu</title>
  </head>
  <body class="bg-gray-50 dark:bg-[#0a0f0d] text-gray-900 dark:text-gray-200 min-h-screen font-mono antialiased transition-colors duration-200">
    <!-- Managed-by banner -->
    <div class="text-center text-[11px] py-1 px-4 border-b border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-500">
      managed by <a href="https://muse.ai" target="_blank" rel="noopener" class="underline hover:text-gray-700 dark:hover:text-gray-300">muse.ai</a>
    </div>

    <!-- Navigation -->
    <nav class="sticky top-0 z-50 bg-gray-50/90 dark:bg-[#0a0f0d]/90 backdrop-blur border-b border-gray-200 dark:border-white/10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-14">
          <a href="/" class="text-sm font-bold tracking-tight">
            <span class="text-emerald-600 dark:text-emerald-400">justin</span><span class="text-gray-400">@web</span><span class="text-gray-500">:~$</span>
          </a>

          <!-- Desktop nav -->
          <div class="hidden sm:flex items-center gap-6 text-sm">
            {links.map((l) => (
              <a
                href={l.href}
                class={l.match(currentPath)
                  ? 'text-emerald-600 dark:text-emerald-400'
                  : 'text-gray-500 dark:text-gray-500 hover:text-gray-900 dark:hover:text-gray-200 transition-colors'}
              >
                ./{l.label}
              </a>
            ))}
            <button
              id="theme-toggle"
              class="text-gray-500 dark:text-gray-500 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
              aria-label="Toggle dark mode"
            >
              <svg id="sun-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
              </svg>
              <svg id="moon-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
              </svg>
            </button>
          </div>

          <!-- Mobile menu button -->
          <div class="sm:hidden flex items-center gap-3">
            <button
              id="theme-toggle-mobile"
              class="text-gray-500 dark:text-gray-500 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
              aria-label="Toggle dark mode"
            >
              <svg class="sun-icon w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
              </svg>
              <svg class="moon-icon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
              </svg>
            </button>
            <button
              id="mobile-menu-btn"
              class="text-gray-500 dark:text-gray-500 hover:text-gray-900 dark:hover:text-gray-200 transition-colors text-sm"
              aria-label="Open menu"
            >
              [menu]
            </button>
          </div>
        </div>

        <!-- Mobile nav -->
        <div id="mobile-menu" class="sm:hidden hidden pb-4 space-y-2 text-sm">
          {links.map((l) => (
            <a
              href={l.href}
              class={l.match(currentPath)
                ? 'block text-emerald-600 dark:text-emerald-400'
                : 'block text-gray-500 dark:text-gray-500 hover:text-gray-900 dark:hover:text-gray-200 transition-colors'}
            >
              ./{l.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <!-- Main content -->
    <main class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-200 dark:border-white/10 mt-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 text-[11px] text-gray-400 dark:text-gray-600 flex justify-between">
        <span>© {new Date().getFullYear()} justin liu</span>
        <span>built with astro</span>
      </div>
    </footer>

    <script is:inline>
      // Dark mode toggle
      function updateThemeIcons(isDark) {
        document.querySelectorAll('#sun-icon, .sun-icon').forEach(el => {
          el.classList.toggle('hidden', isDark);
        });
        document.querySelectorAll('#moon-icon, .moon-icon').forEach(el => {
          el.classList.toggle('hidden', !isDark);
        });
      }

      function toggleTheme() {
        const html = document.documentElement;
        const isDark = html.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateThemeIcons(isDark);
      }

      // Initialize theme
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const isDark = savedTheme === 'dark' || (!savedTheme && prefersDark);
      document.documentElement.classList.toggle('dark', isDark);
      updateThemeIcons(isDark);

      document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
      document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

      // Mobile menu
      document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
        document.getElementById('mobile-menu')?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
