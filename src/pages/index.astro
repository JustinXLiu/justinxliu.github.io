---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <div class="max-w-2xl mx-auto pt-8">
    <!-- Terminal hero -->
    <div class="rounded-lg border border-gray-200 dark:border-white/10 bg-white dark:bg-white/[0.02] overflow-hidden">
      <div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-gray-200 dark:border-white/10">
        <span class="w-2.5 h-2.5 rounded-full bg-gray-300 dark:bg-white/15"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-gray-300 dark:bg-white/15"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-gray-300 dark:bg-white/15"></span>
        <span class="ml-2 text-[11px] text-gray-400 dark:text-gray-600">justin@web: ~</span>
      </div>
      <div class="p-5 sm:p-6 text-sm leading-7">
        <p><span class="text-emerald-600 dark:text-emerald-400">$</span> <span class="text-gray-400 dark:text-gray-500">whoami</span></p>
        <p class="text-xl font-bold text-gray-900 dark:text-gray-100">justin liu</p>
        <p class="mt-3"><span class="text-emerald-600 dark:text-emerald-400">$</span> <span class="text-gray-400 dark:text-gray-500">cat about.txt</span></p>
        <p class="text-gray-600 dark:text-gray-400">personal site — I track my investment portfolio here and write occasional notes.</p>
        <p class="mt-3"><span class="text-emerald-600 dark:text-emerald-400">$</span> <span class="text-gray-400 dark:text-gray-500">ls</span></p>
        <p>
          <a href="/portfolio/" class="text-emerald-600 dark:text-emerald-400 hover:underline">portfolio/</a>
          <span class="text-gray-300 dark:text-gray-700">  </span>
          <a href="/blog/" class="text-emerald-600 dark:text-emerald-400 hover:underline">blog/</a>
        </p>
        <p class="mt-3"><span class="text-emerald-600 dark:text-emerald-400">$</span> <span class="cursor-blink text-gray-400">▊</span></p>
      </div>
    </div>

    <div class="flex gap-3 mt-8 text-sm">
      <a
        href="/portfolio/"
        class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white font-medium transition-colors"
      >
        ./portfolio
      </a>
      <a
        href="/blog/"
        class="px-4 py-2 rounded-md border border-gray-200 dark:border-white/10 hover:border-gray-400 dark:hover:border-white/25 transition-colors"
      >
        ./blog
      </a>
    </div>
  </div>
</Layout>
