---
import Layout from '../../layouts/Layout.astro';

const postModules = import.meta.glob('./*.md', { eager: true }) as Record<string, { frontmatter: Record<string, string>; url?: string }>;
const sorted = Object.entries(postModules)
  .map(([path, mod]) => ({
    ...mod.frontmatter,
    url: '/blog/' + path.replace('./', '').replace('.md', '/'),
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout title="Blog">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8">
      <p class="text-xs text-gray-400 dark:text-gray-600">
        <span class="text-emerald-600 dark:text-emerald-400">$</span> ./blog --list
      </p>
      <h1 class="text-2xl font-bold tracking-tight mt-2">blog</h1>
    </div>

    {sorted.length === 0 ? (
      <p class="text-sm text-gray-400 dark:text-gray-600">no posts yet.</p>
    ) : (
      <ul class="space-y-3">
        {sorted.map((post) => (
          <li>
            <a href={post.url} class="group flex items-baseline justify-between gap-4 rounded-lg border border-gray-200 dark:border-white/10 px-4 py-3 hover:border-emerald-600/50 dark:hover:border-emerald-400/40 transition-colors">
              <span class="font-medium group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">{post.title}</span>
              <span class="text-xs text-gray-400 dark:text-gray-600 shrink-0 tabular-nums">{post.date}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Layout>
